{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true,
		"color": {
			"defaultGradients": false,
			"defaultPalette": false,
			"background": true,
			"text": true,
			"link": true,
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				}
			],
			"custom": true,
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Default",
					"slug": "default",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif"
				},
				{
					"name": "Caveat",
					"slug": "caveat",
					"fontFamily": "Caveat, serif",
					"fontFace": [
						{
							"fontFamily": "Caveat",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/caveat/caveat-v23-latin-regular.woff2" ]
						},
						{
							"fontFamily": "Caveat",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/caveat/caveat-v23-latin-700.woff2" ]
						}
					]
				},
				{
					"name": "Kalam",
					"slug": "kalam",
					"fontFamily": "Kalam, serif",
					"fontFace": [
						{
							"fontFamily": "Kalam",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/kalam/kalam-v18-latin-300.woff2" ]
						},
						{
							"fontFamily": "Kalam",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/kalam/kalam-v18-latin-700.woff2" ]
						}
					]
				}
			],
			"defaultFontSizes": false,
			"fontSizes": [
				{
					"fluid": {
						"max": "1rem",
						"min": "0.875rem"
					},
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.25rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1.25rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.625rem",
						"min": "1.25rem"
					},
					"name": "Large",
					"size": "1.625rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.25rem",
						"min": "1.625rem"
					},
					"name": "Extra Large",
					"size": "2.25rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2rem"
					},
					"name": "Extra Extra Large",
					"size": "3rem",
					"slug": "xx-large"
				}
			],
			"customFontSize": false,
            "lineHeight": true,
            "fontStyle": true,
			"fontWeight": true,
			"dropCap": false,
            "letterSpacing": false,
            "textDecoration": true,
            "textTransform": false,
            "writingMode": true,
			"fluid": true
		},
		"border": {
			"color": true, 
			"radius": true, 
			"style": true, 
			"width": true
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "50rem"
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "0.625rem",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "clamp(0.625rem, 3vw, 1rem)",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(1.25rem, 5vw, 1.75rem)",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(1.5rem, 5vw, 2.75rem)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(2rem, 7vw, 4rem)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(2.5rem, 7vw, 5rem)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(4rem, 10vw, 8rem)",
					"slug": "80"
				}
			],
			"units": [ "%",	"px", "em", "rem", "vh", "vw" ]
		},
		"custom": {}
	},
	"styles": {
		"color": {},
		"typography": {
			"fontFamily": "var:preset|font-family|default",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {},
			"heading": {
				"typography": {
					"lineHeight": "1.125"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"					
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}				
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/verse": {
				"typography": {
					"fontFamily": "var:preset|font-family|kalam",
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.5"
				},
				"css": " &{overflow:hidden !important;text-align:center;}"
			}
		}
	},
	"customTemplates": [],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
