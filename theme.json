{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true,
		"color": {
			"defaultGradients": false,
			"defaultPalette": false,
			"background": true,
			"text": true,
			"link": true,
			"palette": [],
			"custom": true,
			"gradients": [],
			"duotone": []
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Default",
					"slug": "default",
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif"
				},
				{
					"name": "Caveat",
					"slug": "caveat",
					"fontFamily": "Caveat, serif",
					"fontFace": [
						{
							"fontFamily": "Caveat",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/caveat/caveat-v23-latin-regular.woff2" ]
						},
						{
							"fontFamily": "Caveat",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/caveat/caveat-v23-latin-700.woff2" ]
						}
					]
				},
				{
					"name": "Kalam",
					"slug": "kalam",
					"fontFamily": "Kalam, serif",
					"fontFace": [
						{
							"fontFamily": "Kalam",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/kalam/kalam-v18-latin-300.woff2" ]
						},
						{
							"fontFamily": "Kalam",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/kalam/kalam-v18-latin-700.woff2" ]
						}
					]
				}
			],
			"fontSizes": [],
			"customFontSize": false,
            "lineHeight": true,
            "fontStyle": true,
			"fontWeight": true,
			"dropCap": false,
            "letterSpacing": false,
            "textDecoration": true,
            "textTransform": false
		},
		"border": {
			"color": true, 
			"radius": true, 
			"style": true, 
			"width": true
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "52rem"
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"spacingSizes": [],
			"units": [ "%",	"px", "em", "rem", "vh", "vw" ]
		},
		"custom": {}
	},
	"styles": {
		"color": {},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--caveat)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"top": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--60)",
				"bottom": "var(--wp--preset--spacing--50)",
				"left": "var(--wp--preset--spacing--60)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {},
			"heading": {},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}				
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			}
		}
	},
	"customTemplates": [],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
